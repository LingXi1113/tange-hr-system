# 沙箱默认配置：由 scripts/*.sh 读取后导出
HRATS_ENV=development
HRATS_PORT=8100
HRATS_SECRET_KEY=sandbox-only-change-me
HRATS_PLATFORM_PROVIDER=mock
HRATS_ENABLE_MOCK_AUTH=1
HRATS_SEED_DEMO_DATA=1
HRATS_STAGE_RULE_WORKER=1
HRATS_STAGE_RULE_INTERVAL=60

# MongoDB：也可以改成沙箱分配的 MongoDB 地址
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=hr_ats_sandbox

# 前端 Vite 代理目标和端口
HRATS_DEV_PROXY_TARGET=http://127.0.0.1:8100
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173

# 开发环境不配置 OSS 时，后端使用本地文件存储
