# HR招聘系统后端环境变量示例（实际部署从系统环境/CI 注入，不依赖 .env 文件）
# 复制到 shell 环境或 supervisor environment 使用

# 运行环境：development / production（production 下 Mock 登录与演示数据默认关闭）
HRATS_ENV=development

# 服务端口（固定 8100，不建议修改）
HRATS_PORT=8100

# 会话密钥（生产必须修改为随机值）
HRATS_SECRET_KEY=change-me-in-production

# 数据库文件路径（默认 backend/data/hrats.db）

# 平台身份提供方：mock=当前环境Mock平台；open_platform=即先平台（预留未实现）
HRATS_PLATFORM_PROVIDER=mock

# 是否启用 Mock 登录/角色切换接口（默认 dev=1/prod=0；生产必须为 0）
HRATS_ENABLE_MOCK_AUTH=1

# 启动时是否写入演示数据（默认 dev=1/prod=0）
HRATS_SEED_DEMO_DATA=1

# ---------- MongoDB（全部业务数据与文件元数据） ----------
# 开发环境可用本地默认值；生产环境（HRATS_ENV=production）必须显式配置
# MONGODB_URI 与 MONGODB_DATABASE，禁止指向 127.0.0.1/localhost，连接失败将阻止服务启动
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=hr_ats

# ---------- 阿里云 OSS（文件对象存储，凭据严禁写死在代码中） ----------
# 生产环境必须完整配置以下全部变量，缺失将阻止服务启动（禁止降级本地存储）
OSS_ACCESSKEY_ID=your_accesskey_id
OSS_ACCESSKEY_SECRET=your_accesskey_secret
OSS_BUCKET=your-bucket-name
OSS_PREFIX=hr-ats/
# 二选一：直连 endpoint（兼容 OSS_END_POINT 命名）或 region（拼为 https://oss-<region>.aliyuncs.com）
OSS_ENDPOINT=https://oss-cn-<region>.aliyuncs.com
# OSS_REGION=cn-hangzhou
